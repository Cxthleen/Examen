<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Examen.Pages.AppointmentDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top accent bar -->
        <Border Grid.Row="0" Height="4" Background="#2C6BED"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" Margin="48,40,48,48"
                        HorizontalAlignment="Center" Spacing="0">

                <!-- Back button -->
                <Button x:Name="BackButton"
                        Click="BackButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0,0,0,32">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" Foreground="#2C6BED"/>
                        <TextBlock Text="Back to calendar"
                                   Foreground="#2C6BED"
                                   FontSize="14"/>
                    </StackPanel>
                </Button>

                <!-- Card -->
                <Border Background="White"
                        CornerRadius="16"
                        Padding="40">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel Spacing="0">

                        <!-- Header: icon + title -->
                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon circle -->
                            <Border Grid.Column="0"
                                    Width="56" Height="56"
                                    CornerRadius="28"
                                    Background="#EEF3FD"
                                    Margin="0,0,20,0"
                                    VerticalAlignment="Top">
                                <FontIcon Glyph="&#xE787;"
                                          FontSize="24"
                                          Foreground="#2C6BED"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>

                            <!-- Title + badge -->
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <TextBlock x:Name="TitleText"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           Foreground="#0F1C3F"
                                           TextWrapping="Wrap"/>
                                <Border Background="#EEF3FD"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        HorizontalAlignment="Left">
                                    <TextBlock x:Name="BadgeText"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#2C6BED"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="#EEF0F5" Margin="0,0,0,32"/>

                        <!-- Date & time row -->
                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Date -->
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="DATE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#8A93A8"
                                           CharacterSpacing="80"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="#2C6BED"/>
                                    <TextBlock x:Name="DateText"
                                               FontSize="16"
                                               Foreground="#0F1C3F"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Time -->
                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="TIME"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#8A93A8"
                                           CharacterSpacing="80"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE121;" FontSize="16" Foreground="#2C6BED"/>
                                    <TextBlock x:Name="TimeText"
                                               FontSize="16"
                                               Foreground="#0F1C3F"
                                               FontWeight="Medium"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Divider -->
                        <Border Height="1" Background="#EEF0F5" Margin="0,0,0,32"/>

                        <!-- Description -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="NOTES"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#8A93A8"
                                       CharacterSpacing="80"/>
                            <Border Background="#F8F9FC"
                                    CornerRadius="10"
                                    Padding="20">
                                <TextBlock x:Name="DescriptionText"
                                           FontSize="15"
                                           Foreground="#3D4A66"
                                           TextWrapping="Wrap"
                                           LineHeight="24"/>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- Appointment ID footer -->
                <TextBlock x:Name="IdText"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"
                           FontSize="12"
                           Foreground="#B0B8CC"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>