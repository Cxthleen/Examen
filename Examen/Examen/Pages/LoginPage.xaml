<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Examen.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Examen.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
        Width="320"
        VerticalAlignment="Center"
        HorizontalAlignment="Center"
        Spacing="12">

        <TextBlock Text="Login" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBox x:Name="UsernameBox" PlaceholderText="Username" />
        <PasswordBox x:Name="PasswordBox" PlaceholderText="Password" />

        <!-- Error message (hidden by default) -->
        <TextBlock x:Name="ErrorText" Foreground="Red" Visibility="Collapsed" />

        <Button Content="Login" Click="LoginButton_Click"
                HorizontalAlignment="Stretch" Background="#3498DB" Foreground="White"/>

        <Button Content="Don't have an account? Register"
                Click="RegisterButton_Click"
                HorizontalAlignment="Stretch" />

    </StackPanel>
</Page>
