<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CrudApp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Inhoud -->
            <RowDefinition Height="Auto"/>  <!-- Formulier -->
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="📦 Productbeheer"
                           FontSize="26"
                           FontWeight="Bold"/>
                <TextBlock x:Name="WelkomText"
                           FontSize="13"
                           Foreground="Gray"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Uitloggen"
                    VerticalAlignment="Center"
                    Click="UitloggenButton_Click"/>
        </Grid>

        <!-- ===== LIJST + KNOPPEN ===== -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Lijst van producten -->
            <ListView x:Name="ProductenLijst"
                      SelectionChanged="ProductenLijst_SelectionChanged"
                      BorderThickness="1"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      CornerRadius="8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8,4">
                            <TextBlock Text="{Binding Naam}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Prijs, Converter={StaticResource PrijsConverter}}"
                                       Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Actieknoppen -->
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top">
                <Button Content="➕ Nieuw"
                        Width="120"
                        Click="NieuwButton_Click"/>
                <Button Content="✏️ Bewerken"
                        Width="120"
                        x:Name="BewerkButton"
                        IsEnabled="False"
                        Click="BewerkButton_Click"/>
                <Button Content="🗑️ Verwijderen"
                        Width="120"
                        x:Name="VerwijderButton"
                        IsEnabled="False"
                        Click="VerwijderButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== FORMULIER ===== -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Naam -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Naam" FontSize="12"/>
                    <TextBox x:Name="NaamBox" PlaceholderText="Productnaam"/>
                </StackPanel>

                <!-- Prijs -->
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Prijs (€)" FontSize="12"/>
                    <TextBox x:Name="PrijsBox" PlaceholderText="0.00"/>
                </StackPanel>

                <!-- Opslaan -->
                <Button Grid.Column="2"
                        Content="💾 Opslaan"
                        VerticalAlignment="Bottom"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OpslaanButton_Click"/>

                <!-- Annuleren -->
                <Button Grid.Column="3"
                        Content="Annuleren"
                        VerticalAlignment="Bottom"
                        Click="AnnulerenButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
