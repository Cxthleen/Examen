<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CrudApp.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
        <StackPanel Spacing="16">

            <TextBlock Text="🔐 Inloggen"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Gebruikersnaam -->
            <StackPanel Spacing="4">
                <TextBlock Text="Gebruikersnaam"/>
                <TextBox x:Name="UsernameBox" PlaceholderText="Voer gebruikersnaam in"/>
            </StackPanel>

            <!-- Wachtwoord -->
            <StackPanel Spacing="4">
                <TextBlock Text="Wachtwoord"/>
                <PasswordBox x:Name="PasswordBox" PlaceholderText="Voer wachtwoord in"/>
            </StackPanel>

            <!-- Foutmelding -->
            <TextBlock x:Name="ErrorText"
                       Foreground="Red"
                       Visibility="Collapsed"
                       Text="Gebruikersnaam of wachtwoord onjuist."/>

            <!-- Login knop -->
            <Button Content="Inloggen"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="LoginButton_Click"/>

        </StackPanel>
    </Grid>
</Page>
